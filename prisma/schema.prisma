generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ======== AUTH & USERS ========

model User {
  id            String    @id @default(cuid())
  clerkId       String?   @unique
  email         String    @unique
  password      String?
  firstName     String?
  lastName      String?
  role          String    @default("CANDIDATE")
  avatarUrl     String?
  phone         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  candidate     Candidate?
  employer      Employer?
  agency        Agency?
  activities    Activity[]
  emailsSent    EmailLog[]
  assignedJobs  Job[]       @relation("AssignedRecruiter")
  assignedClients Client[]  @relation("AssignedSales")
  referrals     Referral[]  @relation("UserReferrals")
  interviewerInterviews Interview[] @relation("InterviewerInterviews")
  workSessions  EmployeeWorkSession[]
  notifications Notification[]

  microsoftAccessToken  String?
  microsoftRefreshToken String?
  microsoftTokenExpiry  DateTime?
  microsoftEmail        String?
  microsoftConnected    Boolean  @default(false)

  bookingLink    String?
  bookingEnabled Boolean  @default(false)
}

model Employer {
  id        String @id @default(cuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id])
  companyName String
  industry  String?
  website   String?
  createdAt DateTime @default(now())
  jobs      Job[]    @relation("EmployerJobs")
}

model Agency {
  id        String @id @default(cuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id])
  agencyName String
  website   String?
  createdAt DateTime @default(now())
}

// ======== CLIENTS ========

model Client {
  id              String   @id @default(cuid())
  companyName     String
  industry        String?
  companySize     String?
  website         String?
  logoUrl         String?
  location        String?
  address         String?
  feeAgreement    String?
  paymentTerms    String?  @default("30 days")
  defaultFeePercent Float? @default(15)
  source          String?
  pipelineStage   String   @default("LEAD")
  notes           String?
  assignedToId    String?
  assignedTo      User?    @relation("AssignedSales", fields: [assignedToId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contacts        Contact[]
  jobs            Job[]
  placements      Placement[]
  activities      Activity[]
  convertedProspects Prospect[] @relation("ProspectToClient")
  followUps       FollowUp[]
  documents       Document[]
  emailLogs       EmailLog[]
}

model Contact {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  firstName   String
  lastName    String
  email       String?
  phone       String?
  jobTitle    String?
  linkedIn    String?
  isPrimary   Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ======== CANDIDATES ========

model Candidate {
  id              String   @id @default(cuid())
  userId          String?  @unique
  user            User?    @relation(fields: [userId], references: [id])
  firstName       String
  lastName        String
  email           String   @unique
  phone           String?
  location        String?
  headline        String?
  summary         String?
  cvUrl           String?
  cvFileName      String?
  cvParsedData    String?
  salaryMin       Int?
  salaryMax       Int?
  dayRateMin      Int?
  dayRateMax      Int?
  noticePeriod    String?
  availableFrom   DateTime?
  rightToWork     Boolean  @default(false)
  status          String   @default("ACTIVE")
  source          String?
  linkedIn        String?
  isVerified      Boolean  @default(false)
  isPremium       Boolean  @default(false)
  lastContactedAt DateTime?
  industry        String?
  specialism      String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  skills          CandidateSkill[]
  applications    Application[]
  placements      Placement[]
  activities      Activity[]
  interviews      Interview[]
  documents       Document[]
  emailLogs       EmailLog[]
}

// ======== SKILLS ONTOLOGY ========

model Skill {
  id          String   @id @default(cuid())
  name        String   @unique
  shortName   String
  category    String
  platform    String?
  parentId    String?
  parent      Skill?   @relation("SkillHierarchy", fields: [parentId], references: [id])
  children    Skill[]  @relation("SkillHierarchy")
  createdAt   DateTime @default(now())

  candidateSkills CandidateSkill[]
  jobSkills       JobSkill[]
}

model CandidateSkill {
  id            String    @id @default(cuid())
  candidateId   String
  candidate     Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skillId       String
  skill         Skill     @relation(fields: [skillId], references: [id])
  proficiency   Int?
  yearsExp      Int?
  isVerified    Boolean   @default(false)
  verifiedScore Int?
  lastUsed      DateTime?
  createdAt     DateTime  @default(now())

  @@unique([candidateId, skillId])
}

// ======== JOBS ========

model Job {
  id              String   @id @default(cuid())
  clientId        String?
  client          Client?  @relation(fields: [clientId], references: [id])
  employerId      String?
  employer        Employer? @relation("EmployerJobs", fields: [employerId], references: [id])
  title           String
  description     String
  location        String?
  remote          Boolean  @default(false)
  salaryMin       Int?
  salaryMax       Int?
  dayRateMin      Int?
  dayRateMax      Int?
  contractType    String   @default("PERMANENT")
  industry        String?
  feePercent      Float?
  feeAmount       Int?
  source          String   @default("DIRECT")
  sourceRef       String?
  status          String   @default("ACTIVE")
  companyName     String?
  assignedToId    String?
  assignedTo      User?    @relation("AssignedRecruiter", fields: [assignedToId], references: [id])
  publishedAt     DateTime?
  expiresAt       DateTime?
  closedAt        DateTime?
  notes           String?
  aiParsedData    String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  skills          JobSkill[]
  applications    Application[]
  placements      Placement[]
  activities      Activity[]
  interviews      Interview[]
  documents       Document[]
}

model JobSkill {
  id          String  @id @default(cuid())
  jobId       String
  job         Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillId     String
  skill       Skill   @relation(fields: [skillId], references: [id])
  required    Boolean @default(true)
  minScore    Int?

  @@unique([jobId, skillId])
}

// ======== RECRUITING PIPELINE ========

model Application {
  id            String   @id @default(cuid())
  candidateId   String
  candidate     Candidate @relation(fields: [candidateId], references: [id])
  jobId         String
  job           Job      @relation(fields: [jobId], references: [id])
  stage         String   @default("SOURCED")
  matchScore    Int?
  gapAnalysis   String?
  submittedAt   DateTime?
  interviewAt   DateTime?
  offerAmount   Int?
  notes         String?
  rejectionReason String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  activities    Activity[]
  interviews    Interview[]

  @@unique([candidateId, jobId])
}

// ======== PLACEMENTS & REVENUE ========

model Placement {
  id            String   @id @default(cuid())
  candidateId   String
  candidate     Candidate @relation(fields: [candidateId], references: [id])
  jobId         String?
  job           Job?     @relation(fields: [jobId], references: [id])
  clientId      String?
  client        Client?  @relation(fields: [clientId], references: [id])
  role          String
  salary        Int?
  dayRate       Int?
  feeAmount     Int
  feePercent    Float?
  startDate     DateTime
  endDate       DateTime?
  source        String   @default("DIRECT")
  status        String   @default("PENDING")
  invoicedAt    DateTime?
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ======== ACTIVITY LOG ========

model Activity {
  id            String   @id @default(cuid())
  type          String
  title         String
  content       String?
  userId        String?
  user          User?    @relation(fields: [userId], references: [id])
  candidateId   String?
  candidate     Candidate? @relation(fields: [candidateId], references: [id])
  clientId      String?
  client        Client?  @relation(fields: [clientId], references: [id])
  jobId         String?
  job           Job?     @relation(fields: [jobId], references: [id])
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id])
  metadata      String?
  createdAt     DateTime @default(now())
}

// ======== FOLLOW-UPS ========

model FollowUp {
  id            String    @id @default(cuid())
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contactId     String?
  title         String
  description   String?
  channel       String    @default("CALL")
  priority      String    @default("MEDIUM")
  status        String    @default("PENDING")
  dueDate       DateTime
  dueTime       String?
  completedAt   DateTime?
  completedNote String?
  outcome       String?
  reminderAt    DateTime?
  reminderSent  Boolean   @default(false)
  createdById   String?
  assignedToId  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// ======== EMAIL ========

model EmailTemplate {
  id          String   @id @default(cuid())
  name        String
  subject     String
  body        String
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  campaigns   EmailCampaign[]
}

model EmailCampaign {
  id            String    @id @default(cuid())
  name          String
  templateId    String?
  template      EmailTemplate? @relation(fields: [templateId], references: [id])
  subject       String
  body          String
  recipientType String
  recipientQuery String?
  sentCount     Int      @default(0)
  openCount     Int      @default(0)
  clickCount    Int      @default(0)
  replyCount    Int      @default(0)
  bounceCount   Int      @default(0)
  status        String   @default("DRAFT")
  scheduledAt   DateTime?
  sentAt        DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  logs          EmailLog[]
}

model EmailLog {
  id                 String    @id @default(cuid())
  campaignId         String?
  campaign           EmailCampaign? @relation(fields: [campaignId], references: [id])
  sentById           String?
  sentBy             User?    @relation(fields: [sentById], references: [id])
  toEmail            String
  toName             String?
  fromEmail          String?
  fromName           String?
  subject            String
  bodyPreview        String?
  direction          String   @default("received")
  status             String   @default("sent")
  openedAt           DateTime?
  clickedAt          DateTime?
  resendId           String?
  microsoftMessageId String?  @unique
  emailDate          DateTime?
  candidateId        String?
  candidate          Candidate? @relation(fields: [candidateId], references: [id])
  clientId           String?
  client             Client?  @relation(fields: [clientId], references: [id])
  createdAt          DateTime @default(now())
}

// ======== GDPR ========

model GdprConsent {
  id            String   @id @default(cuid())
  email         String
  consentType   String
  consented     Boolean
  ipAddress     String?
  userAgent     String?
  consentedAt   DateTime @default(now())
  withdrawnAt   DateTime?
}

// ======== CSV IMPORTS ========

model ImportJob {
  id          String   @id @default(cuid())
  fileName    String
  entityType  String
  totalRows   Int      @default(0)
  processedRows Int    @default(0)
  errorRows   Int      @default(0)
  errors      String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  completedAt DateTime?
}

// ======== OUTREACH — PROSPECTS ========

model Prospect {
  id              String    @id @default(cuid())
  firstName       String
  lastName        String
  email           String    @unique
  company         String?
  jobTitle        String?
  industry        String?
  companySize     String?
  location        String?
  technologies    String?
  linkedIn        String?
  apolloId        String?   @unique
  emailVerified   Boolean   @default(false)
  verifiedAt      DateTime?
  source          String    @default("MANUAL")
  status          String    @default("NEW")
  segment         String?
  convertedClientId String?
  convertedClient Client?   @relation("ProspectToClient", fields: [convertedClientId], references: [id])
  notes           String?
  lastContactedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  outreachEmails  OutreachEmail[]
  outreachReplies OutreachReply[]
}

// ======== OUTREACH — CAMPAIGNS ========

model OutreachCampaign {
  id              String    @id @default(cuid())
  name            String
  description     String?
  segment         String?
  status          String    @default("DRAFT")
  dailyLimit      Int       @default(50)
  startDate       DateTime?
  endDate         DateTime?
  totalSent       Int       @default(0)
  totalOpened     Int       @default(0)
  totalReplied    Int       @default(0)
  totalBounced    Int       @default(0)
  instantlyId     String?
  sendVia         String?   // "resend" | "outlook"
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  templates       OutreachTemplate[]
  emails          OutreachEmail[]
  metrics         OutreachMetric[]
  liaDocuments    LIADocument[]
}

model OutreachTemplate {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    OutreachCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  stepNumber  Int
  subject     String
  body        String
  variant     String   @default("A")
  openRate    Float?
  replyRate   Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  emails      OutreachEmail[]
}

// ======== OUTREACH — EMAILS ========

model OutreachEmail {
  id            String    @id @default(cuid())
  prospectId    String
  prospect      Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  campaignId    String
  campaign      OutreachCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  templateId    String?
  template      OutreachTemplate? @relation(fields: [templateId], references: [id])
  sentFrom      String?
  subject       String?
  body          String?
  sequenceStep  Int       @default(1)
  status        String    @default("QUEUED")
  sentAt        DateTime?
  openedAt      DateTime?
  repliedAt     DateTime?
  bouncedAt     DateTime?
  sentVia       String?   // "resend" | "outlook"
  scheduledAt   DateTime?
  createdAt     DateTime  @default(now())

  replies       OutreachReply[]
}

model OutreachReply {
  id              String    @id @default(cuid())
  emailId         String?
  email           OutreachEmail? @relation(fields: [emailId], references: [id])
  prospectId      String
  prospect        Prospect  @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  subject         String?
  body            String
  receivedAt      DateTime  @default(now())
  sentiment       String?
  aiClassification String?
  isRead          Boolean   @default(false)
  respondedAt     DateTime?
  respondedBy     String?
  notes           String?
  createdAt       DateTime  @default(now())
}

// ======== OUTREACH — SENDING INFRASTRUCTURE ========

model SendingDomain {
  id                String    @id @default(cuid())
  domain            String    @unique
  provider          String    @default("google")
  isWarmedUp        Boolean   @default(false)
  warmupStartDate   DateTime?
  dailySendLimit    Int       @default(25)
  totalSentToday    Int       @default(0)
  reputationScore   Float?
  spfConfigured     Boolean   @default(false)
  dkimConfigured    Boolean   @default(false)
  dmarcConfigured   Boolean   @default(false)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  mailboxes         SendingMailbox[]
}

model SendingMailbox {
  id              String    @id @default(cuid())
  domainId        String
  domain          SendingDomain @relation(fields: [domainId], references: [id], onDelete: Cascade)
  email           String    @unique
  displayName     String?
  isActive        Boolean   @default(true)
  warmupEnabled   Boolean   @default(true)
  dailyLimit      Int       @default(25)
  sentToday       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ======== OUTREACH — SUPPRESSION ========

model SuppressionList {
  id          String   @id @default(cuid())
  email       String   @unique
  reason      String
  source      String?
  addedAt     DateTime @default(now())
}

// ======== OUTREACH — COMPLIANCE ========

model LIADocument {
  id                  String    @id @default(cuid())
  campaignId          String?
  campaign            OutreachCampaign? @relation(fields: [campaignId], references: [id])
  legitimateInterest  String
  necessityAnalysis   String
  balancingTest       String
  safeguards          String
  createdBy           String?
  status              String    @default("DRAFT")
  createdAt           DateTime  @default(now())
  approvedAt          DateTime?
}

// ======== OUTREACH — METRICS ========

model OutreachMetric {
  id              String   @id @default(cuid())
  date            DateTime
  campaignId      String?
  campaign        OutreachCampaign? @relation(fields: [campaignId], references: [id])
  emailsSent      Int      @default(0)
  emailsOpened    Int      @default(0)
  emailsReplied   Int      @default(0)
  emailsBounced   Int      @default(0)
  positiveReplies Int      @default(0)
  meetingsBooked  Int      @default(0)
  optOuts         Int      @default(0)
  deliveryRate    Float?
  openRate        Float?
  replyRate       Float?
  createdAt       DateTime @default(now())

  @@unique([date, campaignId])
}

// ======== REFERRALS ========

model Referral {
  id              String    @id @default(cuid())
  referrerUserId  String?
  referrerName    String
  referrerEmail   String
  referrerPhone   String?
  candidateName   String
  candidateEmail  String
  candidatePhone  String?
  candidateRole   String?
  candidateSkills String?
  notes           String?
  referralCode    String    @unique
  status          String    @default("PENDING")
  rewardAmount    Int       @default(20000)
  rewardPaid      Boolean   @default(false)
  rewardPaidAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  referrer        User?     @relation("UserReferrals", fields: [referrerUserId], references: [id])
}

// ======== INTERVIEWS ========

model Interview {
  id              String    @id @default(cuid())
  applicationId   String
  application     Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  candidateId     String
  candidate       Candidate @relation(fields: [candidateId], references: [id])
  jobId           String
  job             Job       @relation(fields: [jobId], references: [id])
  interviewerId   String?
  interviewer     User?     @relation("InterviewerInterviews", fields: [interviewerId], references: [id])
  scheduledAt     DateTime
  duration        Int       @default(60)
  type            String    @default("PHONE")
  location        String?
  meetingLink     String?
  notes           String?
  feedback        String?
  rating          Int?
  status          String    @default("SCHEDULED")
  completedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// ======== ATTENDANCE & WORK SESSION TRACKING ========

model EmployeeWorkSession {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date            DateTime @default(now())
  checkInAt       DateTime
  checkOutAt      DateTime?
  workLocation    String   @default("HOME")
  checkInNote     String?
  checkOutSummary String?
  totalMinutes    Int?
  activeMinutes   Int?
  idleMinutes     Int?
  breakMinutes    Int?
  status          String   @default("CHECKED_IN")

  activities      EmployeeActivity[]
  breaks          EmployeeBreak[]

  @@index([userId, date])
}

model EmployeeActivity {
  id            String   @id @default(cuid())
  sessionId     String
  session       EmployeeWorkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type          String
  startedAt     DateTime @default(now())
  endedAt       DateTime?
  durationMin   Int?
  description   String?
}

model EmployeeBreak {
  id          String   @id @default(cuid())
  sessionId   String
  session     EmployeeWorkSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  startedAt   DateTime @default(now())
  endedAt     DateTime?
  reason      String?
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   @default("INFO")
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

// ======== DOCUMENTS ========

// ======== FOLLOW-UP SEQUENCES ========

model FollowUpSequence {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdBy   String?
  steps       FollowUpStep[]
  enrollments SequenceEnrollment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model FollowUpStep {
  id          String   @id @default(cuid())
  sequenceId  String
  sequence    FollowUpSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  dayDelay    Int
  action      String
  subject     String?
  body        String?
  stepOrder   Int
  createdAt   DateTime @default(now())
}

model SequenceEnrollment {
  id            String   @id @default(cuid())
  sequenceId    String
  sequence      FollowUpSequence @relation(fields: [sequenceId], references: [id])
  clientId      String?
  candidateId   String?
  contactEmail  String
  currentStep   Int      @default(0)
  status        String   @default("ACTIVE")
  lastActionAt  DateTime?
  nextActionAt  DateTime?
  enrolledBy    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ======== DOCUMENTS ========

model Document {
  id          String   @id @default(cuid())
  name        String
  fileName    String
  filePath    String
  fileSize    Int?
  mimeType    String?
  category    String   @default("GENERAL")
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id])
  candidateId String?
  candidate   Candidate? @relation(fields: [candidateId], references: [id])
  jobId       String?
  job         Job?     @relation(fields: [jobId], references: [id])
  uploadedBy  String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
